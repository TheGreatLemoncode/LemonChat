<UserControl x:Class="LemonChat.View.EchoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LemonChat.View"
             mc:Ignorable="d" 
             d:DesignHeight="401" d:DesignWidth="547">
    <Grid>
        <StackPanel Margin="10,151,10,146">
            <TextBox x:Name="messager" Height="36"/>
            <StackPanel Orientation="Horizontal" Width="288" Margin="0,10,0,0">
                <Button x:Name="sender" Content="Send" Width="80" Height="50" Margin="50,0,50,0" Click="sender_Click"/>
                <Button x:Name="connect" Content="Connect" Width="80" Click="connect_Click"/>
            </StackPanel>
        </StackPanel>   
    </Grid>
</UserControl>
