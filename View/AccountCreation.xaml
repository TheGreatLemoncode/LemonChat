<UserControl x:Class="LemonChat.View.AccountCreation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LemonChat.View"
             mc:Ignorable="d" 
             d:DesignHeight="401" d:DesignWidth="547">
    <Grid>
        <StackPanel x:Name="stk_creation" HorizontalAlignment="Center" Width="467" VerticalAlignment="Center" Height="381">
            <Label Content="Registration" x:Name="lbl_connexion" FontSize="36"  HorizontalContentAlignment="Center" Height="54" Width="244" FontFamily="Arial Rounded MT Bold"/>
            <Label x:Name="lbl_mail" Content="Mail" FontSize="18" Padding="5,5,5,3" Margin="0,18,0,0" Width="380" HorizontalAlignment="Center" />
            <TextBox x:Name="txtBox_mail" Text="" Margin="0,10,0,0" FontSize="18" HorizontalAlignment="Center" Width="380" Padding="0,0,0,3"/>
            <Label x:Name="lbl_Password" Content="Password" FontSize="18" Padding="5,5,5,3" Margin="0,18,0,0" Width="380" />
            <TextBox x:Name="txtBox_Password" Text="" Margin="0,10,0,0" FontSize="18" Width="380" HorizontalAlignment="Center" Padding="0,0,0,3"/>
            <Label x:Name="lbl_displayName" Content="DisplayName" FontSize="18" HorizontalAlignment="Center" Width="380" Margin="0,18,0,0"/>
            <TextBox x:Name="txtBox_Display" HorizontalAlignment="Center" Width="380" Padding="0,0,0,3" FontSize="18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="67">
                <Button x:Name="btn_submit" Content="Submit" Margin="10,0,10,0" Height="50" Width="100" Click="Submit_click"/>
                <Button x:Name="btn_reset" Content="Reset" Margin="0,0,10,0" Height="50" Width="100" Click="Reset_click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
