<Window x:Class="LemonChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LemonChat"
        xmlns:mv="clr-namespace:LemonChat.ViewModels"
        xmlns:vm="clr-namespace:LemonChat.View"
        mc:Ignorable="d"
        Title="LemonChat" Height="450" Width="800" Closed="Window_Closed" Loaded="Window_Loaded">

    <DockPanel LastChildFill="False" Margin="0,10,0,0">
        <ListBox DockPanel.Dock="Left" Width="119" Height="401" HorizontalContentAlignment="Stretch" Margin="7,9,0,0">
            <Button Margin="0,10,0,30" Height="50" Content="Connexion" FontSize="15" FontFamily="Arial Rounded MT Bold" Click="Show_connexion_click"/>
            <Button Margin="0,0,0,30" Height="50" Content="Register" FontSize="15" FontFamily="Arial Rounded MT Bold" Click="Show_registration_click"/>
        </ListBox>
        <ContentControl x:Name="Display" Width="547" Margin="55,0,0,0" Height="401" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </DockPanel>



</Window>
